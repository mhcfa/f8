{
  "id": "IncomeStatement",
  "title": "Income Statement",
  "subtitle": "($ in Millions)",
  "columns": [
    {
      "kind": "data",
      "id": "line_item",
      "role": "descriptor",
      "headers": [
        "Line Item"
      ]
    },
    {
      "kind": "data",
      "id": "y2023a",
      "role": "measure",
      "headers": [
        "Historical Actuals",
        "2023A"
      ]
    },
    {
      "kind": "data",
      "id": "y2024e",
      "role": "measure",
      "headers": [
        "Forecast Projections",
        "2024E"
      ]
    },
    {
      "kind": "data",
      "id": "y2025e",
      "role": "measure",
      "headers": [
        "Forecast Projections",
        "2025E"
      ]
    },
    {
      "kind": "data",
      "id": "y2026e",
      "role": "measure",
      "headers": [
        "Forecast Projections",
        "2026E"
      ]
    }
  ],
  "rows": [
    {
      "kind": "data",
      "id": "revenue",
      "format": "currency",
      "decimals": 1,
      "expr": "IncomeStatement[\"revenue\", col.prev] * (1.0 + Assumptions[\"rev_growth\", \"val\"])",
      "cells": {
        "line_item": "Revenue",
        "y2023a": 100.0
      }
    },
    {
      "kind": "data",
      "id": "cogs",
      "format": "currency",
      "decimals": 1,
      "expr": "IncomeStatement[\"revenue\", @col] * Assumptions[\"cogs_pct\", \"val\"]",
      "cells": {
        "line_item": {
          "value": "Cost of Goods Sold",
          "indent": 1
        }
      }
    },
    {
      "kind": "data",
      "id": "gross_profit",
      "style": "subtotal",
      "format": "currency",
      "decimals": 1,
      "expr": "IncomeStatement[\"revenue\", @col] - IncomeStatement[\"cogs\", @col]",
      "cells": {
        "line_item": "Gross Profit"
      }
    },
    {
      "kind": "gutter"
    },
    {
      "kind": "section_header",
      "title": "Operating Expenses"
    },
    {
      "kind": "data",
      "id": "opex",
      "format": "currency",
      "decimals": 1,
      "expr": "Assumptions[\"opex_salaries\", \"val\"]",
      "cells": {
        "line_item": {
          "value": "Salaries & SG&A Overhead",
          "indent": 1
        }
      }
    },
    {
      "kind": "data",
      "id": "depreciation",
      "format": "currency",
      "decimals": 1,
      "expr": "Assumptions[\"depreciation\", \"val\"]",
      "cells": {
        "line_item": {
          "value": "Depreciation Expense",
          "indent": 1
        }
      }
    },
    {
      "kind": "gutter"
    },
    {
      "kind": "data",
      "id": "operating_income",
      "style": "subtotal",
      "format": "currency",
      "decimals": 1,
      "expr": "IncomeStatement[\"gross_profit\", @col] - IncomeStatement[\"opex\", @col] - IncomeStatement[\"depreciation\", @col]",
      "cells": {
        "line_item": "Operating Income (EBIT)"
      }
    },
    {
      "kind": "data",
      "id": "tax",
      "format": "currency",
      "decimals": 1,
      "expr": "IncomeStatement[\"operating_income\", @col] * Assumptions[\"tax_rate\", \"val\"]",
      "cells": {
        "line_item": {
          "value": "Income Tax Provision",
          "indent": 1
        }
      }
    },
    {
      "kind": "gutter"
    },
    {
      "kind": "data",
      "id": "net_income",
      "style": "total",
      "highlight": true,
      "format": "currency",
      "decimals": 1,
      "expr": "IncomeStatement[\"operating_income\", @col] - IncomeStatement[\"tax\", @col]",
      "cells": {
        "line_item": "Net Income"
      }
    }
  ]
}