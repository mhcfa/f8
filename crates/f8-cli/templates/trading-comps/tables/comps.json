{
  "id": "Comps",
  "title": "Public Trading Comparables (SaaS Peers)",
  "subtitle": "Enterprise Value and Operational Trading Multiples ($ in Millions, except share price)",
  "columns": [
    {
      "kind": "data",
      "id": "company",
      "role": "descriptor",
      "headers": [
        "Company"
      ]
    },
    {
      "kind": "data",
      "id": "ticker",
      "role": "descriptor",
      "headers": [
        "Ticker"
      ]
    },
    {
      "kind": "gutter"
    },
    {
      "kind": "data",
      "id": "share_price",
      "role": "measure",
      "headers": [
        "Market Data",
        "Share Price"
      ],
      "format": "currency",
      "decimals": 2
    },
    {
      "kind": "data",
      "id": "shares_out",
      "role": "measure",
      "headers": [
        "Market Data",
        "Shares Out"
      ],
      "format": "number",
      "decimals": 1
    },
    {
      "kind": "data",
      "id": "market_cap",
      "role": "measure",
      "headers": [
        "Market Data",
        "Market Cap"
      ],
      "format": "currency",
      "decimals": 1,
      "expr": "Comps[@row, \"share_price\"] * Comps[@row, \"shares_out\"]"
    },
    {
      "kind": "gutter"
    },
    {
      "kind": "data",
      "id": "cash",
      "role": "measure",
      "headers": [
        "Balance Sheet",
        "Cash"
      ],
      "format": "currency",
      "decimals": 1
    },
    {
      "kind": "data",
      "id": "debt",
      "role": "measure",
      "headers": [
        "Balance Sheet",
        "Total Debt"
      ],
      "format": "currency",
      "decimals": 1
    },
    {
      "kind": "data",
      "id": "ev",
      "role": "measure",
      "headers": [
        "Balance Sheet",
        "Enterprise Value"
      ],
      "format": "currency",
      "decimals": 1,
      "expr": "Comps[@row, \"market_cap\"] + Comps[@row, \"debt\"] - Comps[@row, \"cash\"]"
    },
    {
      "kind": "gutter"
    },
    {
      "kind": "data",
      "id": "revenue",
      "role": "measure",
      "headers": [
        "Operating Metrics",
        "LTM Revenue"
      ],
      "format": "currency",
      "decimals": 1
    },
    {
      "kind": "data",
      "id": "ebitda",
      "role": "measure",
      "headers": [
        "Operating Metrics",
        "LTM EBITDA"
      ],
      "format": "currency",
      "decimals": 1
    },
    {
      "kind": "data",
      "id": "ebitda_margin",
      "role": "measure",
      "headers": [
        "Operating Metrics",
        "EBITDA Margin"
      ],
      "format": "percentage",
      "decimals": 1,
      "expr": "Comps[@row, \"ebitda\"] / Comps[@row, \"revenue\"]"
    },
    {
      "kind": "gutter"
    },
    {
      "kind": "data",
      "id": "ev_rev",
      "role": "measure",
      "headers": [
        "Valuation Multiples",
        "EV / Rev"
      ],
      "format": "multiple",
      "decimals": 1,
      "expr": "Comps[@row, \"ev\"] / Comps[@row, \"revenue\"]"
    },
    {
      "kind": "data",
      "id": "ev_ebitda",
      "role": "measure",
      "headers": [
        "Valuation Multiples",
        "EV / EBITDA"
      ],
      "format": "multiple",
      "decimals": 1,
      "expr": "Comps[@row, \"ev\"] / Comps[@row, \"ebitda\"]"
    },
    {
      "kind": "data",
      "id": "pe",
      "role": "measure",
      "headers": [
        "Valuation Multiples",
        "P / E"
      ],
      "format": "multiple",
      "decimals": 1,
      "expr": "Comps[@row, \"market_cap\"] / (Comps[@row, \"ebitda\"] * 0.75)"
    }
  ],
