  "rows": [
    {
      "kind": "data",
      "id": "date",
      "format": "date",
      "expr": "EDATE(Timeline[\"date\", col.prev], 12)",
      "cells": {
        "line_item": "Period End Date",
        "y0": {
          "expr": "DATE(2024, 12, 31)"
        }
      }
    },
    {
      "kind": "data",
      "id": "year",
      "format": "integer",
      "expr": "YEAR(Timeline[\"date\", @col])",
      "cells": {
        "line_item": "Calendar Year"
      }
    },
    {
      "kind": "data",
      "id": "days",
      "format": "number",
      "decimals": 0,
      "expr": "DAYS(Timeline[\"date\", @col], Timeline[\"date\", col.prev])",
      "cells": {
        "line_item": "Period Elapsed Days",
        "y0": 0.0
      }
    },
    {
      "kind": "data",
      "id": "year_frac",
      "format": "number",
      "decimals": 2,
      "expr": "YEARFRAC(Timeline[\"date\", col.prev], Timeline[\"date\", @col], 0)",
      "cells": {
        "line_item": "Year Fraction (30/360)",
        "y0": 0.0
      }
    }
  ]
}