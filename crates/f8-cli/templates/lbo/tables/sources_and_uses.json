{
  "id": "SourcesAndUses",
  "title": "Transaction Sources & Uses of Funds",
  "subtitle": "7-Column Irregular Layout with Intra-Table Dividing Gutter",
  "columns": [
    {
      "kind": "data",
      "id": "source_item",
      "role": "descriptor",
      "headers": [
        "Sources of Financing"
      ]
    },
    {
      "kind": "data",
      "id": "source_val",
      "role": "measure",
      "headers": [
        "Sources ($M)"
      ],
      "format": "currency",
      "decimals": 1
    },
    {
      "kind": "data",
      "id": "source_pct",
      "role": "measure",
      "headers": [
        "% Total"
      ],
      "format": "percentage",
      "decimals": 1
    },
    {
      "kind": "gutter"
    },
    {
      "kind": "data",
      "id": "use_item",
      "role": "descriptor",
      "headers": [
        "Uses of Capital"
      ]
    },
    {
      "kind": "data",
      "id": "use_val",
      "role": "measure",
      "headers": [
        "Uses ($M)"
      ],
      "format": "currency",
      "decimals": 1
    },
    {
      "kind": "data",
      "id": "use_pct",
      "role": "measure",
      "headers": [
        "% Total"
      ],
      "format": "percentage",
      "decimals": 1
    }
  ],
  "rows": [
    {
      "kind": "data",
      "id": "senior_debt",
      "cells": {
        "source_item": "Senior Secured Term Loan",
        "source_val": {
          "expr": "DealAssumptions[\"senior_debt_entry\", \"val\"]"
        },
        "source_pct": {
          "expr": "SourcesAndUses[\"senior_debt\", \"source_val\"] / SourcesAndUses[\"total\", \"source_val\"]"
        },
        "use_item": "Acquisition Target Enterprise Value",
        "use_val": {
          "expr": "DealAssumptions[\"entry_ev\", \"val\"]"
        },
        "use_pct": {
          "expr": "SourcesAndUses[\"senior_debt\", \"use_val\"] / SourcesAndUses[\"total\", \"use_val\"]"
        }
      }
    },
    {
      "kind": "data",
      "id": "sub_debt",
      "cells": {
        "source_item": "Subordinated Mezzanine Notes",
        "source_val": {
          "expr": "DealAssumptions[\"sub_debt_entry\", \"val\"]"
        },
        "source_pct": {
          "expr": "SourcesAndUses[\"sub_debt\", \"source_val\"] / SourcesAndUses[\"total\", \"source_val\"]"
        },
        "use_item": "Financing & Legal Advisory Fees",
        "use_val": 0.0,
        "use_pct": 0.0
      }
    },
    {
      "kind": "data",
      "id": "sponsor_equity",
      "cells": {
        "source_item": "Sponsor Equity Capital",
        "source_val": {
          "expr": "DealAssumptions[\"sponsor_equity_entry\", \"val\"]"
        },
        "source_pct": {
          "expr": "SourcesAndUses[\"sponsor_equity\", \"source_val\"] / SourcesAndUses[\"total\", \"source_val\"]"
        },
        "use_item": "Minimum Balance Sheet Cash Buffer",
        "use_val": 0.0,
        "use_pct": 0.0
      }
    },
    {
      "kind": "gutter"
    },
    {
      "kind": "data",
      "id": "total",
      "style": "total",
      "highlight": true,
      "cells": {
        "source_item": "Total Sources of Financing",
        "source_val": {
          "expr": "SourcesAndUses[\"senior_debt\", \"source_val\"] + SourcesAndUses[\"sub_debt\", \"source_val\"] + SourcesAndUses[\"sponsor_equity\", \"source_val\"]"
        },
        "source_pct": {
          "expr": "SourcesAndUses[\"senior_debt\", \"source_pct\"] + SourcesAndUses[\"sub_debt\", \"source_pct\"] + SourcesAndUses[\"sponsor_equity\", \"source_pct\"]"
        },
        "use_item": "Total Uses of Capital",
        "use_val": {
          "expr": "SourcesAndUses[\"senior_debt\", \"use_val\"] + SourcesAndUses[\"sub_debt\", \"use_val\"] + SourcesAndUses[\"sponsor_equity\", \"use_val\"]"
        },
        "use_pct": {
          "expr": "SourcesAndUses[\"senior_debt\", \"use_pct\"] + SourcesAndUses[\"sub_debt\", \"use_pct\"] + SourcesAndUses[\"sponsor_equity\", \"use_pct\"]"
        }
      }
    }
  ]
}